{
  "name": "feeledu-pj-managing",
  "version": "0.0.0",
  "private": true,
  "description": "Feeledu attendance kiosk and payroll administration",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "idb": "8.0.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud": "tsc --noEmit -p cloudflare/tsconfig.json",
    "cloud:dev": "wrangler dev --ip 127.0.0.1 --port 4174",
    "cloud:check": "npm run typecheck:cloud && wrangler deploy --dry-run --outdir .tmp/cloudflare-build",
    "cloud:deploy": "npm run build && npm run typecheck:cloud && wrangler deploy",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud:e2e": "playwright test --config playwright.cloud.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "type": "module"
}
